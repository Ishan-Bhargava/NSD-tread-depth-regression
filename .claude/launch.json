{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nsd-webapp",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app:app", "--app-dir", "webapp", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "nsd-streamlit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
